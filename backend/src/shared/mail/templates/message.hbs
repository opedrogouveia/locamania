<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f5f7;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f5f7;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;">
            <tr>
              <td style="padding:20px 28px;background:#1d4ed8;color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.2px;">
                {{company.name}}
              </td>
            </tr>
            <tr>
              <td style="padding:28px;">
                <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#111827;">{{title}}</h1>
                {{#if greeting}}<p style="margin:0 0 12px;font-size:15px;line-height:1.6;">{{greeting}}</p>{{/if}}
                {{#each paragraphs}}
                  <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">{{this}}</p>
                {{/each}}
                {{#if button}}
                  <table role="presentation" cellspacing="0" cellpadding="0" style="margin:20px 0 8px;">
                    <tr>
                      <td style="border-radius:8px;background:#1d4ed8;">
                        <a href="{{button.url}}" style="display:inline-block;padding:12px 22px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">{{button.label}}</a>
                      </td>
                    </tr>
                  </table>
                  <p style="margin:8px 0 0;font-size:12px;color:#6b7280;word-break:break-all;">Se o botão não funcionar, copie este endereço: {{button.url}}</p>
                {{/if}}
                {{#if footnote}}<p style="margin:20px 0 0;font-size:13px;line-height:1.5;color:#6b7280;">{{footnote}}</p>{{/if}}
              </td>
            </tr>
            <tr>
              <td style="padding:16px 28px;background:#f9fafb;border-top:1px solid #e5e7eb;font-size:12px;line-height:1.6;color:#6b7280;">
                {{company.name}}{{#if company.city}} · {{company.city}}/{{company.state}}{{/if}}<br />
                {{#if company.whatsapp}}WhatsApp {{company.whatsapp}}{{/if}}{{#if company.phone}} · Tel. {{company.phone}}{{/if}}{{#if company.email}} · {{company.email}}{{/if}}<br />
                Mensagem automática — por favor, não responda este e-mail.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
