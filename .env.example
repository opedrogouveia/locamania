# ============================================================================
# Locamania — variáveis de ambiente (12-factor). NUNCA commitar o .env real.
# Copie para .env e ajuste. Produção: ver docs/DEPLOY.md.
# ============================================================================

# --- Ambiente ---
NODE_ENV=development
# Fuso usado para "hoje", vencimentos e agendamentos.
APP_TIMEZONE=America/Sao_Paulo

# --- API ---
PORT=3201
# Origem permitida no CORS (o frontend). Sem barra no fim.
CORS_ORIGIN=http://localhost:3200
# Endereço público do frontend — vai nos links dos e-mails (convite, redefinição de senha).
APP_PUBLIC_URL=http://localhost:3200

# --- Banco (Postgres) ---
# Dev: o container do docker-compose, na porta 5433.
# Supabase: DATABASE_URL = transaction pooler (6543, ?pgbouncer=true&connection_limit=1)
#           DIRECT_URL   = session pooler (5432) — usado pelas migrations.
DATABASE_URL=postgresql://locamania:locamania@localhost:5433/locamania?schema=public
DIRECT_URL=postgresql://locamania:locamania@localhost:5433/locamania?schema=public

# --- Auth (JWT) ---
# Gere um segredo forte: `openssl rand -base64 48`. Trocar invalida todas as sessões.
JWT_SECRET=troque-este-segredo-em-producao
# Validade da sessão da equipe e do cliente (o cliente usa o celular e não quer logar toda hora).
JWT_STAFF_EXPIRES_IN=12h
JWT_CUSTOMER_EXPIRES_IN=30d

# --- Agendador ---
# Segredo exigido por POST /jobs/run (chamado pelo GitHub Actions, porque o plano
# gratuito do Render hiberna e o cron interno não roda com o serviço dormindo).
JOBS_SECRET=troque-este-segredo-dos-jobs
# Liga o cron interno (08:00 no fuso acima). Em produção com Render free, deixe true
# mesmo assim: quando o serviço está acordado, ele roda; o GitHub Actions cobre o resto.
JOBS_CRON_ENABLED=true

# --- Pagamentos ---
# sandbox = PIX de teste, confirmado por webhook assinado. Nenhum valor é cobrado.
PAYMENT_GATEWAY=sandbox
# Segredo do HMAC do webhook do gateway (no sandbox, usado pelo simulador).
PAYMENT_WEBHOOK_SECRET=troque-este-segredo-do-webhook

# --- WhatsApp ---
# disabled = os avisos oferecem o link oficial click-to-chat (wa.me) com a mensagem
# pronta; o envio automático exige a WhatsApp Business Platform (Meta).
WHATSAPP_PROVIDER=disabled

# --- Rastreador ---
# sandbox = posições simuladas e comandos registrados, sem equipamento real.
TRACKER_PROVIDER=sandbox

# --- E-mail ---
# Dev: o Mailpit do docker-compose captura tudo (http://localhost:8026).
# Sem MAIL_HOST a API sobe normalmente e só registra o e-mail no log.
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Locamania <no-reply@locamania.com.br>"

# --- Observabilidade (opcional) ---
SENTRY_DSN=

# --- Seed (usuários de demonstração) ---
SEED_PASSWORD=changeme123

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3201
NEXT_PUBLIC_APP_NAME=Locamania
